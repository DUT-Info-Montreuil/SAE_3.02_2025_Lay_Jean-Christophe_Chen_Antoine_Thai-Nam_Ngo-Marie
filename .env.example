# Copy to .env and fill in. NOTE: the code does not read these variables yet
# (credentials are currently hardcoded in Connexion.php); this documents the
# configuration the app needs.
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=buvette
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8
# Optional: absolute path of the private folder holding legal documents (outside the web root).
# Ignored if empty or not absolute; default is ../documentsLegaux_prive.
ICONNECT_DOCS_LEGAUX=
